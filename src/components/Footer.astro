---
import { withBase } from "../lib/urls";
---

<footer class="site-footer">
  <a href={withBase("/impressum/")}>Kontakt &amp; Impressum</a>
  <ul class="social-links" aria-label="Social Media">
    <li>
      <a href="https://www.linkedin.com/in/blanchefabri/" rel="me noopener" aria-label="LinkedIn">
        <img src={withBase("/icons/linkedin.svg")} alt="" width="24" height="24" />
      </a>
    </li>
    <li>
      <a href="https://www.instagram.com/blanchefabri/" rel="me noopener" aria-label="Instagram">
        <img src={withBase("/icons/instagram.svg")} alt="" width="24" height="24" />
      </a>
    </li>
    <li>
      <a href="https://www.threads.net/@blanchefabri" rel="me noopener" aria-label="Threads">
        <img src={withBase("/icons/threads.svg")} alt="" width="24" height="24" />
      </a>
    </li>
  </ul>
</footer>

<style>
  .site-footer {
    display: flex;
    min-height: 74px;
    align-items: center;
    justify-content: space-between;
    padding: 18px 42px;
    background: #000;
    color: #fff;
    font-size: 16px;
  }

  .social-links {
    display: flex;
    align-items: center;
    gap: 33px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .social-links a {
    display: block;
    width: 24px;
    height: 24px;
  }

  @media (max-width: 599px) {
    .site-footer {
      min-height: 92.5625px;
      align-items: stretch;
      justify-content: flex-start;
      gap: 0;
      padding: 0;
      font-size: 16.2415px;
      line-height: 25.9864px;
    }

    .site-footer > a {
      display: flex;
      flex: 0 0 223.484375px;
      align-items: center;
      justify-content: center;
      padding: 20.3019px 38.5736px;
      text-align: center;
    }

    .social-links {
      flex: 0 0 118.515625px;
      height: 48px;
      flex-wrap: wrap;
      align-content: flex-start;
      justify-content: space-between;
      gap: 0 24px;
      margin: 22.28125px 24px;
    }
  }
</style>
