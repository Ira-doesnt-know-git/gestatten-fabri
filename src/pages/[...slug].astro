---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { formatDate, slugify } from "../lib/articles";
import { withBase } from "../lib/urls";

export async function getStaticPaths() {
  const articles = await getCollection("articles", ({ data }) => !data.draft);
  return articles.map((article) => ({
    params: { slug: article.data.slug },
    props: { article },
  }));
}

interface Props {
  article: CollectionEntry<"articles">;
}

const { article } = Astro.props;
const { Content } = await render(article);
---

<BaseLayout title={article.data.title} description={article.data.description} image={article.data.coverImage}>
  <main id="main-content" class="article-page">
    <article class="article-shell">
      <h1>{article.data.title}</h1>
      <div class="article-body">
        <Content />
      </div>

      <hr />

      <div class="article-footer-meta">
        <div class="article-meta">
          <p>Beitrag veröffentlicht</p>
          <time datetime={article.data.publishedAt.toISOString()}>{formatDate(article.data.publishedAt)}</time>
          <p>in</p>
          <a href={withBase("/category/beitraege/")}>Beiträge</a>
          <span class="meta-break" aria-hidden="true"></span>
          <p>von</p>
          <p>{article.data.author}</p>
        </div>

        {article.data.tags.length > 0 && (
          <div class="article-tags">
            <p>Schlagwörter:</p>
            <div>
              {article.data.tags.map((tag, index) => (
                <>
                  <a href={withBase(`/tag/${slugify(tag)}/`)}>{tag}</a>{index < article.data.tags.length - 1 ? ", " : ""}
                </>
              ))}
            </div>
          </div>
        )}
      </div>
    </article>
  </main>
</BaseLayout>

<style is:global>
  .article-page {
    margin-bottom: 8px;
    padding: 138px 0 0;
  }

  .article-page h1 {
    margin: 0 0 48px;
    font-size: 58px;
    font-weight: 250;
    line-height: 1.2;
  }

  .article-body p {
    margin: 8px 0 0;
  }

  .article-body p:first-child {
    margin-top: 0;
  }

  .article-body p:has(> strong:only-child) {
    margin-top: 26px;
  }

  .article-body strong {
    font-weight: 600;
  }

  .article-body .article-lead {
    margin-top: 36px;
    font-size: 30px;
    line-height: 48px;
  }

  .article-body .article-kicker {
    font-size: 36px;
    line-height: 57.6px;
  }

  .article-body .article-drop-cap {
    margin-top: 22px;
  }

  .article-body .article-drop-cap::first-letter {
    float: left;
    margin: 0.05em 0.1em 0 0;
    font-size: 8.4em;
    font-weight: 100;
    line-height: 0.68;
  }

  .article-body .article-after-spacer {
    margin-top: 36px;
  }

  .article-body h2,
  .article-body h3 {
    margin: 32px 0 8px;
    font-weight: 400;
    line-height: 1.35;
  }

  .article-body h2 {
    font-size: 30px;
  }

  .article-body h3 {
    margin: 8px 0 0;
    font-size: 36px;
    font-weight: 100;
    line-height: 1.4;
  }

  .article-body blockquote {
    margin: 26px 0;
    padding-left: 32px;
    border-left: 1px solid var(--black);
    font-style: normal;
  }

  .article-body img,
  .article-body figure,
  .article-body video,
  .article-body iframe {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    margin-top: 8px;
    max-width: 100%;
  }

  .article-body hr {
    width: 100%;
    height: 2px;
    margin: 8px 0 0;
    border: 0;
    border-top: 1px solid #808080;
  }

  .article-body .article-short-rule {
    width: 100px;
    margin-inline: auto;
    border-top-width: 2px;
  }

  .article-shell > hr {
    width: 900px;
    height: 2px;
    margin: 128px 0 0 -125px;
    border: 0;
    border-top: 2px solid #808080;
  }

  .article-footer-meta {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 32px;
    width: 900px;
    margin: 32px 0 0 -125px;
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    align-content: start;
    gap: 0 4.98816px;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.6;
  }

  .article-meta p,
  .article-tags p {
    margin: 0;
  }

  .meta-break {
    flex-basis: 100%;
    height: 0;
  }

  .article-tags {
    display: flex;
    flex-direction: column;
    gap: 4.98816px;
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
  }

  @media (max-width: 599px) {
    .article-page {
      padding: 154px 0 0;
    }

    .article-page h1 {
      margin-bottom: 28.8px;
      font-size: 35.5878px;
      line-height: 1.2;
      letter-spacing: -0.01em;
    }

    .article-body .article-lead {
      font-size: 28.2415px;
      line-height: 45.1864px;
    }

    .article-body blockquote {
      padding-left: 24px;
    }

    .article-footer-meta {
      display: flex;
      flex-direction: column;
      width: auto;
      margin: 24px 0 0;
      gap: 24px;
    }

    .article-tags {
      gap: 4.43946px;
      font-size: 14.2415px;
      line-height: 22.7864px;
    }

    .article-meta {
      gap: 0 4.43946px;
      font-size: 14.2415px;
      line-height: 22.7864px;
    }

    .article-shell > hr {
      width: auto;
      height: 2px;
      margin: 80px 0 0;
      border-top-width: 2px;
    }
  }
</style>
