---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  backToTop?: boolean;
}

const {
  title,
  description = "Gestatten: Fabri – Struktur, Story, Film und Serie.",
  image = "/Header.png",
  backToTop = false,
} = Astro.props;

const pageTitle = title ? `${title} – Gestatten: Fabri` : "Gestatten: Fabri";
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang="de" id="top">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="Gestatten: Fabri" href="/rss.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content="Gestatten: Fabri" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Zum Inhalt springen</a>
    <Header currentPath={Astro.url.pathname} />
    <slot />
    <Footer />
    {backToTop && <a class="back-to-top" href="#top" aria-label="Nach oben">↑</a>}
  </body>
</html>
